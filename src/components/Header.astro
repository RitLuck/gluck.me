---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="glass-header">
	<nav>
		<div class="brand">
			<h2><a href={`${base}/`}>{SITE_TITLE}</a></h2>
		</div>

		<div class="internal-links">
			<HeaderLink href="/">🏠 Home</HeaderLink>

			<!-- Blog Dropdown (Technical & Personal) -->
			<div class="dropdown">
				<HeaderLink href="/blog" class="dropdown-trigger">📝 Blog ▾</HeaderLink>
				<div class="dropdown-menu">
					<a href={`${base}/blog/technical`}>💻 Technical</a>
					<a href={`${base}/blog/personal`}>☕ Personal</a>
				</div>
			</div>

			<HeaderLink href="/explory">📷 Photography</HeaderLink>
			<HeaderLink href="/my-list">🎬 My List</HeaderLink>
			<HeaderLink href="/about">👤 whoami</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.glass-header {
	position: sticky;
	top: 0;
	z-index: 100;
	width: 100%;
	background: rgba(5, 5, 5, 0.8) !important;
	backdrop-filter: blur(12px);
	-webkit-backdrop-filter: blur(12px);
	border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.75rem 1.5rem;
	}

	h2 {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 700;
	}

	h2 a {
		color: #ffffff;
		text-decoration: none;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.internal-links a {
		color: #d1d5db;
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
		transition: color 0.2s ease;
		padding: 0.4rem 0.6rem;
		border-radius: 6px;
	}

	.internal-links a:hover,
	.internal-links a.active {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.1);
	}

	/* Dropdown for Blog */
	.dropdown {
		position: relative;
		display: inline-block;
	}

	.dropdown-menu {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 150px;
		background: #18181b;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		box-shadow: 0 10px 25px rgba(0,0,0,0.5);
		padding: 0.5rem 0;
		z-index: 110;
	}

	.dropdown:hover .dropdown-menu {
		display: flex;
		flex-direction: column;
	}

	.dropdown-menu a {
		padding: 0.5rem 1rem;
		border-radius: 0;
	}

	.dropdown-menu a:hover {
		background: rgba(255, 255, 255, 0.08);
	}
</style>