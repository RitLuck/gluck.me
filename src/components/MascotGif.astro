---
// src/components/MascotGif.astro
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="sidebar-mascot">
    <img 
        src={`${base}/mascot.gif`} 
        alt="Ado Mascot" 
        class="mascot-img" 
        onerror="this.style.display='none';"
    />
</div>

<style>
    .sidebar-mascot {
        margin-top: 1rem;
        display: flex;
        justify-content: flex-start;
        width: 100%;
    }

    .mascot-img {
        width: 110px;
        height: auto;
        display: block;
        filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5));
    }
</style>