---
interface Props {
  photosData: Array<{
    lat: number;
    lng: number;
    date: string;
    title?: string;
    thumbnails: string[];
  }>;
}

const { photosData } = Astro.props;
---

<div id="explory-map"></div>

<script is:inline define:vars={{ photosData }}>
  window.__PHOTOS_DATA__ = photosData;
</script>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster';
  import 'leaflet.markercluster/dist/MarkerCluster.css';

  document.addEventListener('DOMContentLoaded', () => {
    const data = (window as any).__PHOTOS_DATA__ || [];
    
    const map = L.map('explory-map', {
      zoomControl: true,
      minZoom: 2
    }).setView([35.3060, 139.4827], 6);

    // 100% Free Dark Map Tiles (No API Key / No Watermarks)
        L.tileLayer('https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; <a href="https://stadiamaps.com/">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          maxZoom: 20
        }).addTo(map);

    // Force map to recalculate bounds and eliminate grey bottom area
    setTimeout(() => {
      map.invalidateSize();
    }, 100);

    // Custom cluster logic: sums total photos across all grouped markers
    const markers = (L as any).markerClusterGroup({
      showCoverageOnHover: false,
      maxClusterRadius: 50,
      iconCreateFunction: (cluster: any) => {
        const children = cluster.getAllChildMarkers();
        let totalPhotosInCluster = 0;
        
        children.forEach((child: any) => {
          totalPhotosInCluster += child.options.photoCount || 0;
        });

        return L.divIcon({
          html: `<div class="explory-cluster">${totalPhotosInCluster}</div>`,
          className: 'explory-cluster-wrap',
          iconSize: L.point(44, 44)
        });
      }
    });

    data.forEach((item: any) => {
      const totalPhotos = item.thumbnails.length;
      const displayPhotos = item.thumbnails.slice(0, 6);
      const extraCount = totalPhotos > 6 ? totalPhotos - 6 : 0;

      const customIcon = L.divIcon({
        html: `<div class="explory-cluster">${totalPhotos}</div>`,
        className: 'explory-cluster-wrap',
        iconSize: L.point(44, 44)
      });

      const marker = L.marker([item.lat, item.lng], {
        icon: customIcon,
        photoCount: totalPhotos
      } as any);

      const formattedDate = new Date(item.date).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });

      const popupContent = `
        <div class="explory-card">
          <div class="card-header">
            <span class="photo-count">${totalPhotos} photo${totalPhotos > 1 ? 's' : ''}</span>
            <span class="click-hint">Click to view details</span>
          </div>

          <div class="card-grid">
            ${displayPhotos.map((img: string) => `<img src="${img}" alt="Thumbnail" />`).join('')}
            ${extraCount > 0 ? `
              <div class="more-tile">
                <span class="more-num">+${extraCount}</span>
                <span class="more-text">More</span>
              </div>
            ` : ''}
          </div>

          <div class="card-footer">
            <div class="footer-row">
              <span class="icon">🎯</span>
              <span>${item.lat.toFixed(4)}°N, ${item.lng.toFixed(4)}°E</span>
            </div>
            <div class="footer-row">
              <span class="icon">🗓️</span>
              <span>${formattedDate}</span>
            </div>
          </div>
        </div>
      `;

      marker.bindPopup(popupContent, { 
        maxWidth: 320, 
        className: 'explory-custom-popup',
        closeButton: false 
      });
      markers.addLayer(marker);
    });

    map.addLayer(markers);
  });
</script>

<style is:global>
  #explory-map {
    width: 100vw;
    height: 100vh;
    border-radius: 0;
    z-index: 1;
  }

  .explory-custom-popup .leaflet-popup-content-wrapper {
    background: #1d1d21;
    color: #f4f4f5;
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 20px 30px rgba(0, 0, 0, 0.4);
  }

  .explory-custom-popup .leaflet-popup-content {
    margin: 0;
    line-height: 1.4;
  }

  .explory-custom-popup .leaflet-popup-tip {
    background: #1d1d21;
  }

  .explory-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    width: 280px;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .photo-count {
    font-weight: 700;
    font-size: 1.1rem;
    color: #ffffff;
  }

  .click-hint {
    font-size: 0.75rem;
    color: #909098;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .card-grid img {
    width: 100%;
    height: 80px;
    object-fit: cover;
    border-radius: 10px;
  }

  .more-tile {
    background: #2a2a30;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 80px;
  }

  .more-num {
    font-weight: 700;
    font-size: 1.1rem;
    color: #ffffff;
  }

  .more-text {
    font-size: 0.75rem;
    color: #a0a0a8;
  }

  .card-footer {
    border-top: 1px solid #2e2e35;
    padding-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.8rem;
    color: #a0a0a8;
  }

  .footer-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .explory-cluster-wrap {
    background: transparent;
  }

  .explory-cluster {
    width: 44px;
    height: 44px;
    background: rgba(43, 49, 78, 0.85);
    border: 3px solid rgba(100, 110, 160, 0.6);
    color: #ffffff;
    font-weight: bold;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }
</style>