---
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const entry = await getEntry('myList', 'index');
if (!entry) {
  throw new Error('Could not find src/content/my_list/index.md');
}

const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="My List" description="Single page media tracking list" />
		<style>
			body {
				background-color: #0f0f11;
				color: #e4e4e7;
				margin: 0;
			}
			main {
				max-width: 800px;
				margin: 3rem auto;
				padding: 0 1.5rem;
				font-family: system-ui, -apple-system, sans-serif;
			}
			.content-card {
				background: #18181b;
				border: 1px solid #27272a;
				border-radius: 12px;
				padding: 2.5rem;
				box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
			}
			.content-card :global(h1),
			.content-card :global(h2) {
				color: #ffffff;
				border-bottom: 1px solid #27272a;
				padding-bottom: 0.5rem;
				margin-top: 2.5rem;
				scroll-margin-top: 5rem; /* Offsets scroll position for fixed headers */
			}
			.content-card :global(h3) {
				color: #a1a1aa;
				margin-top: 1.5rem;
			}
			.content-card :global(ul) {
				line-height: 1.8;
				color: #d4d4d8;
			}
			.content-card :global(a) {
				color: #60a5fa;
				text-decoration: none;
			}
			.content-card :global(a:hover) {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="content-card">
				<Content />
			</div>
		</main>
		<Footer />
	</body>
</html>