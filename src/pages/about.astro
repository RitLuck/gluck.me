---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const aboutEntries = await getCollection('about');
const entry = aboutEntries.find(e => e.id.includes('whoami')) || aboutEntries[0];

if (!entry) {
  throw new Error('No markdown file found in src/content/about/');
}

const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={entry.data.title || 'Whoami'} description="Personal profile" />
		<style>
			html, body {
				background-color: #050505 !important;
				color: #e4e4e7;
				margin: 0;
			}

			main {
				max-width: 740px;
				margin: 3rem auto 6rem;
				padding: 0 1.5rem;
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
			}

			.about-header {
				margin-bottom: 2.5rem;
				border-bottom: 1px solid #1c1c20;
				padding-bottom: 1.5rem;
			}

			.about-title {
				font-size: 2.5rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0 0 0.5rem 0;
			}

			.about-meta {
				color: #71717a;
				font-size: 0.9rem;
			}

			.prose {
				color: #d4d4d8;
				line-height: 1.85;
				font-size: 1.05rem;
			}

			.prose :global(p) {
				margin-bottom: 1.5rem;
			}

			.prose :global(h3) {
				color: #ffffff;
				font-size: 1.35rem;
				margin-top: 2.5rem;
				margin-bottom: 1rem;
				font-weight: 600;
			}

			.prose :global(blockquote) {
				border-left: 3px solid #3f3f46;
				padding-left: 1.25rem;
				margin: 1.75rem 0;
				color: #a1a1aa;
				font-style: italic;
			}

			.prose :global(strong) {
				color: #ffffff;
			}

			.prose :global(em) {
				color: #e4e4e7;
			}

			.prose :global(hr) {
				border: none;
				border-top: 1px solid #1c1c20;
				margin: 3rem 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-header">
				<h1 class="about-title">{entry.data.title || 'Whoami'}</h1>
				<span class="about-meta">Personal profile</span>
			</div>

			<article class="prose">
				<Content />
			</article>
		</main>
		<Footer />
	</body>
</html>